{
  "name": "atelier-restauration",
  "version": "0.1.0",
  "private": true,
  "description": "Restauration et préservation de photographies + photobooks premium",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "gallery": "tsx scripts/build-gallery.ts",
    "images": "tsx scripts/build-public-images.ts",
    "e2e": "python3 scripts/e2e-checkout.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "postgres": "3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.20.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
