# ---------------------------------------------------------------------------
# Atelier Restauration — configuration
# Copier en .env.local pour le développement. Aucune valeur n'est obligatoire
# en local : PGlite, le stockage local et le mailer console sont les défauts.
# ---------------------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL publique du stockage objet (prod uniquement)
# NEXT_PUBLIC_STORAGE_BASE_URL=

# --- Base de données -------------------------------------------------------
# Absent => Postgres embarqué (PGlite) dans .data/pg
# DATABASE_URL=postgresql://user:password@host:5432/atelier

# --- Stockage --------------------------------------------------------------
# local (défaut) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/files
# STORAGE_S3_BUCKET=atelier-originals
# STORAGE_S3_REGION=gra
# STORAGE_S3_ENDPOINT=https://s3.gra.perf.cloud.ovh.net
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# --- Paiement --------------------------------------------------------------
# Liste ordonnée des moyens de règlement actifs.
#   manual = virement bancaire ou espèces à l'atelier (attente du règlement)
#   cod    = paiement à la livraison, contre-remboursement (travail immédiat)
PAYMENT_PROVIDERS=manual,cod
# Instructions affichées au client pour le paiement manuel (clé i18n ou texte libre)
PAYMENT_MANUAL_IBAN=TN59 0000 0000 0000 0000 0000
PAYMENT_MANUAL_BANK=Banque — Agence — Titulaire du compte

# --- Emails ----------------------------------------------------------------
# console (défaut, écrit dans .data/mail) | resend
MAILER_DRIVER=console
MAILER_FROM="Atelier Restauration <bonjour@atelier-restauration.tn>"
# RESEND_API_KEY=

# --- Sécurité --------------------------------------------------------------
# Secret de signature des jetons d'accès invité & de téléchargement
# Générer : openssl rand -hex 32
APP_SECRET=change-me-in-production-please-use-openssl-rand-hex-32
CRON_SECRET=change-me-too

# --- Compte administrateur créé par le seed --------------------------------
SEED_ADMIN_EMAIL=admin@atelier-restauration.tn
SEED_ADMIN_PASSWORD=changeme-please
